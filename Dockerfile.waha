ARG WAHA_BASE_IMAGE=devlikeapro/waha:latest-2026.9.1@sha256:41283bd89922ec3f722e5a772b844c451634d4aa72e9c34043c3480184f970fe
FROM ${WAHA_BASE_IMAGE}

COPY scripts/patch-waha-utils.js /tmp/patch-waha-utils.js
RUN node /tmp/patch-waha-utils.js && rm /tmp/patch-waha-utils.js

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
  CMD curl -fsS -H "X-Api-Key: $WAHA_API_KEY" http://localhost:3000/health || exit 1

USER node
